<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="http://localhost:3000/static/conimal_css/css.css">
</head>
<body>

    <div class="board_wrap">
        <div class="board_title">
            <strong>자유게시판</strong>
            <p>자유롭게 정보를 주고받아보세요.</p>
        </div>

        <div class="board_view_wrap">


            <div class="board_view">
                
                <div class="title">
                    <%= content.title %>
                </div>
                
                <div class="info">

                    <dl>
                        <dt>글 ID</dt>
                        <dd><%= content.notice_id %></dd>
                    </dl>
                    <dl>
                        <dt>글쓴이</dt>
                        <dd><%= content.writer %></dd>
                    </dl>
                    <dl>
                        <dt>작성일</dt>
                        <dd>2023-06-12</dd>
                    </dl>
                    
                </div>

                <div class="cont">
                    <%= content.content %>
                </div>
                
            </div>
            <div class="bt_wrap">
                <a href="http://localhost:3000/notice" class="on">목록</a>
                <a href="submit">수정</a>
            </div>
        </div>
    </div>

</body>
</html>